{
  "name": "dsh-layerfs",
  "version": "0.1.0",
  "description": "LayerFS × DSH: agents fork, mount and merge LayerFS projects from bash, and the conversation shows who did what",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "icon.svg", "cordis.patch.yml", "locale/*.json"],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-alpha.4 <0.3.0"
  },
  "dependencies": {
    "@dsh-layerfs/host": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
