{
  "type": "layerfs-mock-scenario",
  "version": 2,
  "title": "Tour",
  "order": 1,
  "blurb": "One agent at the terminals: fs writes, a Sandbox terminal that installs, builds and serves, a stale Workspace that merges on commit, a second Workspace in the same Sandbox, and two publishes, the second overwriting the first.",
  "fixture": "../../demo-workspace",
  "lib": "../shared/terminal.mjs",
  "agents": {
    "root": [
      {"pause":1209},
      {"bash":{"description":"fork feature-home","run":[["history","fork feature-home"]]},"phase":"Fork","expect":["branch.fork:Forked"]},
      {"pause":477},
      {"bash":{"description":"fs on feature-home: edit app/page.tsx \"Hello world\" \"Welcome to Layer…","run":[["fs","feature-home","edit","app/page.tsx","Hello world","Welcome to LayerFS"]]},"phase":"Write with fs","expect":["fs.edit:Committed"]},
      {"pause":971},
      {"bash":{"description":"fs on feature-home: mkdir app/about","run":[["fs","feature-home","mkdir","app/about"],["fs","feature-home","write","app/about/page.tsx","export default function Page() {\n  return <main><h1>We're building with LayerFS</h1></main>;\n}\n"]]},"expect":["fs.mkdir:Committed","fs.write:Committed"]},
      {"pause":947},
      {"bash":{"description":"sb1: open a Sandbox terminal on feature-home","run":[["open","sb1","feature-home"]]},"phase":"Build","expect":["sandbox.create:Ready","sandbox.mount:Mounted"]},
      {"pause":466},
      {"bash":{"description":"sb1: sh install.sh","run":[["term","sb1","sh install.sh"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":535},
      {"bash":{"description":"sb1: sh build.sh","run":[["term","sb1","sh build.sh"]]},"expect":["sandbox.exec:exit:1"]},
      {"pause":471},
      {"bash":{"description":"sb1: sed -i \"s/We're/We\\&apos;re/\" app/about/page.tsx","run":[["term","sb1","sed -i \"s/We're/We\\&apos;re/\" app/about/page.tsx"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":535},
      {"bash":{"description":"sb1: sh build.sh","run":[["term","sb1","sh build.sh"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":748},
      {"bash":{"description":"sb1: sh serve.sh &","run":[["term","sb1","sh serve.sh &"]]},"phase":"Serve","expect":["operator.process.start:running"]},
      {"pause":509},
      {"bash":{"description":"sb1: unmount","run":[["term","sb1","unmount"]]},"expect":["sandbox.unmount:Busy"]},
      {"pause":517},
      {"bash":{"description":"sb1: stop","run":[["term","sb1","stop"]]},"expect":["operator.process.cancel:Stopped"]},
      {"pause":722},
      {"bash":{"description":"sb1: commit","run":[["term","sb1","commit"]]},"phase":"Commit","expect":["sandbox.commit:Committed"]},
      {"pause":1073},
      {"bash":{"description":"fs on feature-home: write CHANGELOG.md \"- about page\"","run":[["fs","feature-home","write","CHANGELOG.md","- about page"]]},"phase":"Stale Workspace","expect":["fs.write:Committed"]},
      {"pause":816},
      {"bash":{"description":"sb1: echo \"PORT=3000\" > .env.example","run":[["term","sb1","echo \"PORT=3000\" > .env.example"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":722},
      {"bash":{"description":"sb1: commit","run":[["term","sb1","commit"]]},"expect":["sandbox.commit:Committed"]},
      {"pause":904},
      {"bash":{"description":"sb2: split sb1","run":[["split","sb1","sb2"]]},"phase":"Split","expect":["sandbox.mount:Mounted"]},
      {"pause":1024},
      {"bash":{"description":"sb2: echo \"Built with LayerFS\" >> README.md","run":[["term","sb2","echo \"Built with LayerFS\" >> README.md"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":1079},
      {"bash":{"description":"sb2: commit","run":[["term","sb2","commit"]]},"expect":["sandbox.commit:Committed"]},
      {"pause":509},
      {"bash":{"description":"sb1: unmount","run":[["term","sb1","unmount"]]},"expect":["sandbox.unmount:Unmounted"]},
      {"pause":1287},
      {"bash":{"description":"sb2: unmount","run":[["term","sb2","unmount"]]},"expect":["sandbox.unmount:Unmounted","sandbox.close:Closed"]},
      {"pause":1117},
      {"bash":{"description":"fork header from C4","run":[["history","fork header from C4"]]},"phase":"Second Branch","expect":["branch.fork:Forked"]},
      {"pause":1344},
      {"bash":{"description":"fs on header: write app/header.tsx \"export const Header = () => <head…","run":[["fs","header","write","app/header.tsx","export const Header = () => <header/>;"]]},"expect":["fs.write:Committed"]},
      {"pause":840},
      {"bash":{"description":"publish feature-home","run":[["history","publish feature-home"]]},"phase":"Publish","expect":["branch.publish:Added"]},
      {"pause":717},
      {"bash":{"description":"publish header","run":[["history","publish header"]]},"expect":["branch.publish:Added"]},
      {"reply":"main has header's files only: publish overwrites, and feature-home's Layer stays in history. Merge first to keep both."}
