{
  "type": "layerfs-mock-scenario",
  "version": 2,
  "title": "Conflicts",
  "order": 3,
  "blurb": "The two conflict kinds and how each is resolved: a Workspace against its Branch head (markers in the Workspace), and Branch against Branch (merge refused until the sides agree).",
  "fixture": "../../demo-workspace",
  "lib": "../shared/terminal.mjs",
  "agents": {
    "root": [
      {"pause":863},
      {"bash":{"description":"fork feature","run":[["history","fork feature"]]},"phase":"Workspace conflict","expect":["branch.fork:Forked"]},
      {"pause":1298},
      {"bash":{"description":"sb1: open a Sandbox terminal on feature","run":[["open","sb1","feature"]]},"expect":["sandbox.create:Ready","sandbox.mount:Mounted"]},
      {"pause":761},
      {"bash":{"description":"sb1: sed -i \"s/Hello world/Hello from the Workspace/\" app/page.tsx","run":[["term","sb1","sed -i \"s/Hello world/Hello from the Workspace/\" app/page.tsx"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":810},
      {"bash":{"description":"fs on feature: edit app/page.tsx \"Hello world\" \"Hello from fs\"","run":[["fs","feature","edit","app/page.tsx","Hello world","Hello from fs"]]},"expect":["fs.edit:Committed"]},
      {"pause":722},
      {"bash":{"description":"sb1: commit","run":[["term","sb1","commit"]]},"expect":["sandbox.commit:Conflict"]},
      {"pause":1117},
      {"bash":{"description":"sb1: cat app/page.tsx","run":[["term","sb1","cat app/page.tsx"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":484},
      {"bash":{"description":"sb1: sed -i '/Hello from fs\\|^<<<<<<<\\|^=======\\|^>>>>>>>/d' app/page…","run":[["term","sb1","sed -i '/Hello from fs\\|^<<<<<<<\\|^=======\\|^>>>>>>>/d' app/page.tsx"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":722},
      {"bash":{"description":"sb1: commit","run":[["term","sb1","commit"]]},"expect":["sandbox.commit:Committed"]},
      {"pause":509},
      {"bash":{"description":"sb1: unmount","run":[["term","sb1","unmount"]]},"expect":["sandbox.unmount:Unmounted","sandbox.close:Closed"]},
      {"pause":1168},
      {"bash":{"description":"fork header","run":[["history","fork header"]]},"phase":"Branch conflict","expect":["branch.fork:Forked"]},
      {"pause":502},
      {"bash":{"description":"fs on header: edit app/page.tsx \"Hello world\" \"Hello from header\"","run":[["fs","header","edit","app/page.tsx","Hello world","Hello from header"]]},"expect":["fs.edit:Committed"]},
      {"pause":576},
      {"bash":{"description":"merge feature header as release","run":[["history","merge feature header as release"]]},"expect":["branch.merge:Conflict"]},
      {"pause":1095},
      {"bash":{"description":"fs on header: edit app/page.tsx \"Hello from header\" \"Hello from the W…","run":[["fs","header","edit","app/page.tsx","Hello from header","Hello from the Workspace"]]},"expect":["fs.edit:Committed"]},
      {"pause":576},
      {"bash":{"description":"merge feature header as release","run":[["history","merge feature header as release"]]},"expect":["branch.merge:Merged"]},
      {"pause":1000},
      {"bash":{"description":"publish release","run":[["history","publish release"]]},"phase":"Publish","expect":["branch.publish:Added"]},
      {"reply":"Both conflicts are resolved and release is on main."}
    ]
  }
}
