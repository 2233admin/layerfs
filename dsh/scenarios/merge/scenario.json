      {"pause":761},
      {"bash":{"description":"sb1: sed -i \"s/Hello world/Hello from the Workspace/\" app/page.tsx","run":[["term","sb1","sed -i \"s/Hello world/Hello from the Workspace/\" app/page.tsx"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":862},
      {"bash":{"description":"fs on feature: edit README.md \"# Website\" \"# Website (feature)\"","run":[["fs","feature","edit","README.md","# Website","# Website (feature)"]]},"expect":["fs.edit:Committed"]},
      {"pause":722},
      {"bash":{"description":"sb1: commit","run":[["term","sb1","commit"]]},"expect":["sandbox.commit:Committed"]},
      {"pause":779},
      {"bash":{"description":"fs on feature: edit app/page.tsx \"Hello from the Workspace\" \"Hello fr…","run":[["fs","feature","edit","app/page.tsx","Hello from the Workspace","Hello from fs"]]},"phase":"Commit conflict","expect":["fs.edit:Committed"]},
      {"pause":1083},
      {"bash":{"description":"sb1: sed -i \"s/Hello from the Workspace/Hello, Workspace/\" app/page.t…","run":[["term","sb1","sed -i \"s/Hello from the Workspace/Hello, Workspace/\" app/page.tsx"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":722},
      {"bash":{"description":"sb1: commit","run":[["term","sb1","commit"]]},"expect":["sandbox.commit:Conflict"]},
      {"pause":1117},
      {"bash":{"description":"sb1: cat app/page.tsx","run":[["term","sb1","cat app/page.tsx"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":722},
      {"bash":{"description":"sb1: commit","run":[["term","sb1","commit"]]},"expect":["sandbox.commit:Conflict"]},
      {"pause":484},
      {"bash":{"description":"sb1: sed -i '/Hello from fs\\|^<<<<<<<\\|^=======\\|^>>>>>>>/d' app/page…","run":[["term","sb1","sed -i '/Hello from fs\\|^<<<<<<<\\|^=======\\|^>>>>>>>/d' app/page.tsx"]]},"expect":["sandbox.exec:exit:0"]},
      {"pause":722},
      {"bash":{"description":"sb1: commit","run":[["term","sb1","commit"]]},"expect":["sandbox.commit:Committed"]},
      {"pause":509},
      {"bash":{"description":"sb1: unmount","run":[["term","sb1","unmount"]]},"expect":["sandbox.unmount:Unmounted","sandbox.close:Closed"]},
      {"pause":1168},
      {"bash":{"description":"fork header","run":[["history","fork header"]]},"phase":"Merge","expect":["branch.fork:Forked"]},
      {"pause":1344},
      {"bash":{"description":"fs on header: write app/header.tsx \"export const Header = () => <head…","run":[["fs","header","write","app/header.tsx","export const Header = () => <header/>;"]]},"expect":["fs.write:Committed"]},
      {"pause":576},
      {"bash":{"description":"merge feature header as release","run":[["history","merge feature header as release"]]},"expect":["branch.merge:Merged"]},
      {"pause":502},
      {"bash":{"description":"fs on header: edit app/page.tsx \"Hello world\" \"Hello from header\"","run":[["fs","header","edit","app/page.tsx","Hello world","Hello from header"]]},"phase":"Merge conflict","expect":["fs.edit:Committed"]},
