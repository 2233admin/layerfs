      {"bash":{"description":"merge release header as release-2","run":[["history","merge release header as release-2"]]},"expect":["branch.merge:Conflict"]},
      {"pause":1150},
      {"bash":{"description":"fs on header: edit app/page.tsx \"Hello from header\" \"Hello, Workspace\"","run":[["fs","header","edit","app/page.tsx","Hello from header","Hello, Workspace"]]},"expect":["fs.edit:Committed"]},
      {"pause":899},
      {"bash":{"description":"merge release header as release-2","run":[["history","merge release header as release-2"]]},"expect":["branch.merge:Merged"]},
      {"pause":765},
      {"bash":{"description":"publish release-2","run":[["history","publish release-2"]]},"phase":"Publish","expect":["branch.publish:Added"]},
      {"reply":"main has feature's and header's work."}
